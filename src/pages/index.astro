---
import '../styles/tokens.css';

const email = 'dhanushkadilshancc@gmail.com';
const linkedin = 'https://www.linkedin.com/in/dhanushkacc/';
const github = 'https://github.com/dhanushkacc';
const cvHref = '/Dhanushka_Dilshan_CV.pdf';
const mailto = 'mailto:' + email + '?subject=' + encodeURIComponent('Hello, from your portfolio');

const F = '/media/films/';

const projects = [
  {
    id: 'lineage', name: 'Business Lineage', tags: 'GraphQL, data map', meta: 'GraphQL API and data map, 2026', film: 'ep8-map', start: 0,
    caption: 'Business Lineage, from the finale',
    text: "An interactive map of how data flows between sources, data models, datasets and systems, and which classifications, policies and compliance rules apply on the way. I designed and built it on Spring for GraphQL: neighbouring nodes load in batches, large graphs page through with cursors, and a size limit stops any one request from loading it all.",
  },
  {
    id: 'governance', name: 'Data governance core', tags: 'REST, OpenAPI', meta: 'REST APIs, contract first, 2025 to 2026', film: 'governance', start: 2.6,
    caption: 'Data governance APIs',
    text: "The APIs at the centre of XAPI's data governance. They let an organization catalog its data sources and model them as ER-style data models, with datasets, fields and relationships. Every endpoint started as an OpenAPI contract, so the frontend team could build against it the same day.",
  },
  {
    id: 'access', name: 'Access and cache', tags: 'Security, speed', meta: 'Security and performance, 2025 to 2026', film: 'access', start: 2.6,
    caption: 'Six services, one cache',
    text: "I hardened role-based access control across six or more microservices and closed a flaw that could leak one user's session data into another request. Then I made the checks fast: permissions load in batches, sit in an in-memory Caffeine cache, and stay in sync across service instances through RabbitMQ.",
  },
  {
    id: 'streaming', name: 'XCLP streaming', tags: 'Full-stack, AWS', meta: 'Spring Boot and Angular, 2025', film: 'streaming', start: 2.6,
    caption: 'Signed, not shared',
    text: "For XCLP, the company's compliance learning platform, I built secure course video with AWS CloudFront signed cookies, so only enrolled learners can watch. Around it I built the course, enrollment and sign-in features in Spring Boot and Angular.",
  },
  {
    id: 'agents', name: 'AI-assisted engineering', tags: 'Claude Code, MCP', meta: 'Skills, subagents and MCP servers, 2026', film: 'agents', start: 2.6,
    caption: 'Tools for the assistant',
    text: "I set up our engineering workflow on Claude Code, with custom skills, subagents and Kubernetes MCP servers that let an agent read production logs and trace a bug to the service responsible, read-only and with guardrails. I also extended XAPI's MCP server so assistants can use the platform's features as tools.",
  },
];

const series = [
  { n: 1, title: 'Why GraphQL', topic: 'One screen, two ways', date: 'Oct 22', length: '0:30' },
  { n: 2, title: 'The schema', topic: 'The contract', date: 'Oct 24', length: '0:39' },
  { n: 3, title: 'Resolvers', topic: 'Field by field', date: 'Oct 26', length: '0:44' },
  { n: 4, title: 'The N+1 problem', topic: 'Watch the database log', date: 'Oct 28', length: '0:42' },
  { n: 5, title: 'DataLoader', topic: '101 queries become 2', date: 'Oct 30', length: '0:38' },
  { n: 6, title: 'Securing GraphQL', topic: 'Depth and complexity limits', date: 'Nov 1', length: '0:44' },
  { n: 7, title: 'Pagination', topic: 'One page at a time', date: 'Nov 3', length: '0:46' },
  { n: 8, title: 'Business Lineage', topic: 'Where it all came together', date: 'Nov 5', length: '0:51' },
];
const firstEp = 4;
const epCaption = (s) => `Part ${s.n}: ${s.title}`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dhanushka Dilshan, backend engineer</title>
  <meta name="description" content="Backend engineer in Colombo building XAPI's data governance APIs and Business Lineage with Java, Spring Boot and GraphQL." />
  <meta name="theme-color" content="#0a0d14" />
  <link rel="icon" href="/favicon.png" />
  <script is:inline>document.documentElement.classList.add('js')</script>
  <link rel="preconnect" href="https://api.fontshare.com" />
  <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
  <link href="https://api.fontshare.com/v2/css?f[]=switzer@400,500,600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/scenes/stage.css" />
  <link rel="preload" as="image" href="/media/portrait-tech.jpg" />
</head>
<body>
  <main>

    <!-- SPLIT ONE: the reading column on the left, the held stage on the right -->
    <div class="split" data-split>
      <div class="read">

        <!-- HERO -->
        <header class="hero" id="top" data-stage="hero" data-caption="Dhanushka Dilshan">
          <nav class="nav small" aria-label="Sections">
            <div class="nav__links">
              <a class="link" href="#work">Work</a>
              <a class="link" href="#graphql-series">GraphQL series</a>
              <a class="link" href="#about">About</a>
              <a class="link" href="#contact">Contact</a>
            </div>
            <a class="link nav__cv" href={cvHref}>Download CV</a>
          </nav>
          <figure class="hero__photo m-only">
            <img src="/media/portrait-tech.jpg" width="1024" height="1536" alt="Dhanushka Dilshan in a white shirt, arms crossed, in a dark room lit in blue" fetchpriority="high" />
          </figure>
          <div class="hero__body">
            <h1 class="display lines">
              <span class="line"><span data-line style="--i:0">Dhanushka</span></span>
              <span class="line"><span data-line style="--i:1">Dilshan</span></span>
            </h1>
            <p class="lead hero__sentence" data-load style="--d:420ms">Backend engineer in Colombo. I build the GraphQL and data-governance APIs behind XAPI, at X-Venture.</p>
            <div class="hero__actions" data-load style="--d:520ms">
              <a class="btn" href={mailto}>Get in touch</a>
              <a class="link" href="#work">See the work</a>
            </div>
          </div>
        </header>

        <!-- INTRO -->
        <section class="sec intro" id="intro" data-stage="intro" data-caption="DataLoader: 101 queries become 2">
          <h2 class="head" data-reveal>What I build</h2>
          <figure class="m-film m-only" data-reveal>
            <video muted loop playsinline preload="none" poster={F + 'ep5.jpg'} width="720" height="720" aria-hidden="true"><source src={F + 'ep5.mp4'} type="video/mp4" /></video>
          </figure>
          <div class="intro__text">
            <p class="intro__first" data-reveal>I build the APIs that show where an organization's data comes from, where it goes and which rules apply to it.</p>
            <p data-reveal style="--d:80ms">At X-Venture I work on XAPI, a platform for data, API and AI governance: catalogs, data models, lineage and access control.</p>
            <p data-reveal style="--d:160ms">I write each API as a contract first and care about what a request costs: how many queries it makes, whether it hits the cache, how large it is allowed to get.</p>
            <p data-reveal style="--d:240ms">When something is hard to explain, I make a short video about it. <a class="link" href="#graphql-series">Watch the GraphQL series</a></p>
          </div>
        </section>

        <!-- WORK -->
        <section class="sec work" id="work" aria-labelledby="work-h">
          <h2 class="head" id="work-h" data-reveal>Selected work</h2>
          <ol class="index" data-reveal>
            {projects.map((p) => (
              <li><a class="index__row" href={'#' + p.id} data-index={p.id}><span class="index__name">{p.name}</span><span class="index__tags small">{p.tags}</span></a></li>
            ))}
          </ol>
          {projects.map((p) => (
            <article class="project" id={p.id} data-stage={p.id} data-caption={p.caption}>
              <figure class="m-film m-only" data-reveal>
                <video muted loop playsinline preload="none" data-start={p.start} poster={F + p.film + '.jpg'} width="720" height="720" aria-hidden="true"><source src={F + p.film + '.mp4'} type="video/mp4" /></video>
              </figure>
              <h3 class="project__name" data-reveal>{p.name}</h3>
              <p class="project__meta small muted" data-reveal style="--d:60ms">{p.meta}</p>
              <p class="project__text" data-reveal style="--d:120ms">{p.text}</p>
            </article>
          ))}
        </section>
      </div>

      <div class="stage" aria-hidden="true">
        <div class="slide slide--photo is-on" data-slide="hero">
          <img class="media" src="/media/portrait-tech.jpg" width="1024" height="1536" alt="" />
        </div>
        <div class="slide" data-slide="intro">
          <div class="media film"><video muted loop playsinline preload="none" poster={F + 'ep5.jpg'} width="720" height="720"><source src={F + 'ep5.mp4'} type="video/mp4" /></video></div>
        </div>
        {projects.map((p) => (
          <div class="slide" data-slide={p.id}>
            <div class="media film"><video muted loop playsinline preload="none" data-start={p.start} poster={F + p.film + '.jpg'} width="720" height="720"><source src={F + p.film + '.mp4'} type="video/mp4" /></video></div>
          </div>
        ))}
        <div class="stage__bar small"><span class="stage__cap" data-cap>Dhanushka Dilshan</span><span class="muted">Colombo, Sri Lanka</span></div>
      </div>
    </div>

    <!-- SCENE: the eight videos open from a window to the whole screen -->
    <section class="scene series" id="graphql-series" data-scene="opening" data-options='{"hold":1.4}' aria-labelledby="films-h">
      <div class="scene-stage series__stage">
        <ol class="series__cards" aria-label="The eight videos">
          {series.map((s) => (
            <li class="series__card" data-move><img src={F + 'ep' + s.n + '.jpg'} width="720" height="720" loading="lazy" alt={'Part ' + s.n + ', ' + s.title} /></li>
          ))}
        </ol>
        <div class="series__text" data-move>
          <h2 class="head" id="films-h">GraphQL in Practice</h2>
          <p class="lead series__lead">Eight short animated videos I made on GraphQL with Spring, from the first query to the feature they add up to.</p>
        </div>
      </div>
    </section>

    <!-- SPLIT TWO -->
    <div class="split split--b" data-split>
      <div class="read">

        <section class="sec films" id="watch" data-stage={'ep' + firstEp} data-caption={epCaption(series[firstEp - 1])} data-films aria-labelledby="watch-h">
          <h2 class="head" id="watch-h" data-reveal>Watch any part</h2>
          <p class="muted films__sub" data-reveal style="--d:60ms">On LinkedIn from October 22 to November 5, 2026. Each part runs under a minute.</p>
          <figure class="m-film m-only" data-reveal>
            <video data-films-player muted loop playsinline preload="none" poster={F + 'ep' + firstEp + '.jpg'} width="720" height="720" aria-hidden="true"><source src={F + 'ep' + firstEp + '.mp4'} type="video/mp4" /></video>
          </figure>
          <ul class="eps" data-reveal style="--d:120ms">
            {series.map((s) => (
              <li>
                <button class="ep" type="button" data-ep={s.n} data-caption={epCaption(s)} aria-pressed={s.n === firstEp ? 'true' : 'false'}>
                  <span class="ep__dot" aria-hidden="true"></span>
                  <span class="ep__title">{s.title}<span class="ep__topic small muted">{s.topic}</span></span>
                  <span class="ep__date small muted">{s.date}</span>
                </button>
              </li>
            ))}
          </ul>
        </section>

        <section class="sec demo" id="demo" data-stage="ep1" data-caption="Part 1: Why GraphQL" data-query-demo aria-labelledby="demo-h">
          <h2 class="head" id="demo-h" data-reveal>Ask for exactly what you need</h2>
          <p class="muted demo__sub" data-reveal style="--d:60ms">Tick the fields you want. The response changes shape to match, the way GraphQL does.</p>
          <div class="demo__body" data-reveal style="--d:120ms">
            <fieldset class="demo__fields">
              <legend class="sr-only">Fields to request</legend>
              <label><input type="checkbox" value="name" checked /> name</label>
              <label><input type="checkbox" value="role" checked /> role</label>
              <label><input type="checkbox" value="stack" /> stack</label>
              <label><input type="checkbox" value="projects" /> projects</label>
              <label><input type="checkbox" value="writing" /> writing</label>
            </fieldset>
            <pre class="demo__pane"><code set:html={'query {\n  <span data-query-fields>name\n  role</span>\n}'} /></pre>
            <pre class="demo__pane demo__pane--out"><code data-query-output>{'{ }'}</code></pre>
          </div>
        </section>

        <section class="sec about" id="about" data-stage="about" data-caption="Dhanushka Dilshan, Colombo" aria-labelledby="about-h">
          <img class="about__face" src="/media/portrait-face.jpg" width="176" height="176" alt="" data-reveal />
          <h2 class="head" id="about-h" data-reveal style="--d:60ms">Contract first,<br />then the code</h2>
          <div class="about__letter">
            <p data-reveal>I write each API as an OpenAPI contract before the code, so the frontend can build against it the same day.</p>
            <p data-reveal style="--d:60ms">Every feature ships with JUnit and Mockito tests, a SonarQube check and an 80% coverage target. Day to day that means Java, Spring Boot, Spring for GraphQL, Spring Security, RabbitMQ, Kubernetes and AWS.</p>
            <p data-reveal style="--d:120ms">I studied Computer Science at the University of Colombo School of Computing and joined X-Venture as an intern in November 2024. Six months later I joined full time to build XAPI.</p>
            <p data-reveal style="--d:180ms">When an idea is hard to explain in a meeting, I animate it. That is how GraphQL in Practice started.</p>
          </div>
          <p class="about__sign" data-reveal><span class="lead">Dhanushka Dilshan</span><span class="small muted">Backend software engineer, X-Venture</span></p>
          <div class="about__actions" data-reveal>
            <a class="btn" href={mailto}>Get in touch</a>
            <a class="link" href={cvHref}>Download CV</a>
          </div>
        </section>
      </div>

      <div class="stage" aria-hidden="true">
        {series.map((s) => (
          <div class={'slide' + (s.n === firstEp ? ' is-on' : '')} data-slide={'ep' + s.n}>
            <div class="media film"><video muted loop playsinline preload="none" poster={F + 'ep' + s.n + '.jpg'} width="720" height="720"><source src={F + 'ep' + s.n + '.mp4'} type="video/mp4" /></video></div>
          </div>
        ))}
        <div class="slide slide--photo" data-slide="about">
          <img class="media" src="/media/portrait-close.jpg" width="640" height="800" loading="lazy" alt="" />
        </div>
        <div class="stage__bar small"><span class="stage__cap" data-cap>{epCaption(series[firstEp - 1])}</span><span class="muted">GraphQL in Practice</span></div>
      </div>
    </div>

    <!-- CONTACT: one prompt, one field -->
    <section class="contact" id="contact" aria-labelledby="contact-h">
      <div class="contact__col">
        <h2 class="contact__prompt" id="contact-h" data-reveal><span class="muted">Hiring a backend engineer?</span><br />Write me a line.</h2>
        <form class="contact__form" action={'mailto:' + email} method="get" data-mail={email} data-reveal style="--d:80ms">
          <input type="hidden" name="subject" value="Hello, from your portfolio" />
          <label class="sr-only" for="msg">Your message</label>
          <input class="contact__field" id="msg" name="body" type="text" autocomplete="off" placeholder="We're hiring a backend engineer for..." aria-describedby="msg-note" />
          <button class="contact__send" type="submit" aria-label="Send by email">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" /></svg>
          </button>
        </form>
        <p class="small muted contact__note" id="msg-note" data-reveal style="--d:120ms">It opens your email app with this line, addressed to me.</p>
        <dl class="contact__rows small" data-reveal style="--d:160ms">
          <div><dt class="muted">Email</dt><dd><a class="link" href={mailto}>{email}</a></dd></div>
          <div><dt class="muted">LinkedIn</dt><dd><a class="link" href={linkedin}>linkedin.com/in/dhanushkacc</a></dd></div>
          <div><dt class="muted">GitHub</dt><dd><a class="link" href={github}>github.com/dhanushkacc</a></dd></div>
          <div><dt class="muted">Based in</dt><dd>Colombo, Sri Lanka</dd></div>
        </dl>
      </div>
    </section>
  </main>

  <!-- FOOTER: the last frame of the series on one half, the menu on the other -->
  <footer class="footer">
    <div class="footer__film">
      <video muted loop playsinline preload="none" poster={F + 'ep8-map.jpg'} width="720" height="720" aria-hidden="true"><source src={F + 'ep8-map.mp4'} type="video/mp4" /></video>
    </div>
    <div class="footer__menu">
      <p class="footer__mark small">Dhanushka Dilshan</p>
      <ul class="footer__links">
        <li><a href="#work">Work</a></li>
        <li><a href="#graphql-series">GraphQL series</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#contact">Contact</a></li>
        <li><a href={cvHref}>CV</a></li>
      </ul>
      <div class="footer__blocks small">
        <p><a class="link" href={mailto}>{email}</a><br />Colombo, Sri Lanka</p>
        <p><a class="link" href={linkedin}>LinkedIn</a><br /><a class="link" href={github}>GitHub</a></p>
      </div>
      <p class="footer__legal small muted">© 2026 Dhanushka Dilshan. The videos and photographs are my own.</p>
    </div>
  </footer>

  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js" integrity="sha384-XmJ9SoHtVOHoQUcKvFAzVXwdkKo1Ie3bhmSoIAkcdsHGaIrVJIkmozyq0FJeb/Ly" crossorigin="anonymous"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/ScrollTrigger.min.js" integrity="sha384-wl5TeDVvOWt30Pbf8aSo2ZrzsOjddu3avOBvHe+p+OhJt9gP6w9YXmDkN5DK2/dF" crossorigin="anonymous"></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.3.26/dist/lenis.min.js" integrity="sha384-jqpi9VmOdhyLoLURgjCn7EpnG9BbnHW57ibIZoeaIU+erWDH3k8fQQg0xH2ySjnw" crossorigin="anonymous"></script>
  <script is:inline src="/scenes/stage.js"></script>
  <script is:inline src="/scripts/site.js"></script>
  <script is:inline src="/scripts/query-demo.js" type="module"></script>

  <style is:global>
    /* ---------- the split ---------- */
    .split { display: grid; grid-template-columns: minmax(0, 46fr) minmax(0, 54fr); }
    .read { padding: 0 var(--pad); min-width: 0; }
    .stage { position: sticky; top: 0; height: 100svh; background: var(--stage); overflow: clip; }
    .m-only { display: none; }

    .slide { position: absolute; inset: 0; clip-path: inset(100% 0 0 0); z-index: 0; }
    .slide.is-on { clip-path: inset(0); z-index: 2; }
    .slide.was-on { clip-path: inset(0); z-index: 1; }
    .slide--photo .media { position: absolute; inset: 0 0 56px 0; width: 100%; height: calc(100% - 56px); object-fit: cover; object-position: 50% 22%; }
    .film { position: absolute; inset: clamp(24px, 4vw, 64px) clamp(24px, 4vw, 64px) calc(56px + clamp(24px, 4vw, 64px)); }
    .film video { width: 100%; height: 100%; object-fit: contain; background: var(--stage); }
    .stage__bar {
      position: absolute; left: 0; right: 0; bottom: 0; height: 56px; z-index: 3;
      display: flex; align-items: center; justify-content: space-between; gap: 16px;
      padding: 0 var(--pad); background: var(--bg);
    }
    .stage__cap { display: inline-block; }
    @media (prefers-reduced-motion: no-preference) {
      .js .slide.is-on { transition: clip-path 900ms var(--ease-in-out); }
      .js .slide.is-on .media { animation: slide-settle 1500ms var(--ease-soft); }
      .js .stage__cap.is-new { animation: cap-in 600ms var(--ease-expo); }
    }
    @keyframes cap-in { from { opacity: 0; transform: translateY(10px); } }
    @keyframes slide-settle { from { transform: scale(1.06); } }

    /* ---------- hero ---------- */
    .hero { min-height: 100svh; display: flex; flex-direction: column; }
    .nav { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: clamp(20px, 2.4vw, 32px) 0; }
    .nav__links { display: flex; gap: clamp(16px, 2vw, 28px); }
    .hero__body { margin-top: auto; padding-bottom: clamp(56px, 12svh, 140px); }
    .hero__sentence { max-width: 30ch; margin-top: 40px; }
    .hero__actions { display: flex; align-items: center; gap: 28px; margin-top: 36px; }
    @media (prefers-reduced-motion: no-preference) {
      .js .split:first-child .stage { animation: stage-open 1100ms var(--ease-in-out) 120ms both; }
      .js .split:first-child .slide--photo.is-on .media { animation: settle 1400ms var(--ease-expo) 80ms both; }
    }
    @keyframes stage-open { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0); } }
    @keyframes settle { from { transform: scale(1.1); } to { transform: none; } }

    /* ---------- reading sections ---------- */
    .sec { padding-top: var(--gap-section); }
    .sec > .head { max-width: 16ch; }
    .intro__text { max-width: 44ch; margin-top: 40px; display: grid; gap: 1.1em; }
        .intro__text .intro__first { color: var(--ink); font-weight: 500; font-size: var(--step-lead); line-height: 1.35; letter-spacing: -0.015em; }

    .index { margin-top: 40px; max-width: 46ch; }
    .index__row {
      display: flex; justify-content: space-between; align-items: baseline; gap: 16px; min-height: 48px; padding: 10px 0;
      text-decoration: none; color: var(--muted); transition: color var(--t-hover) ease, transform var(--t-ui) var(--ease-out);
    }
    .index__name { font-size: var(--step-lead); letter-spacing: -0.015em; }
    .index__row.is-current { color: var(--ink); }
    .index__row.is-current .index__tags { color: var(--accent); }
    @media (hover: hover) and (pointer: fine) { .index__row:hover { color: var(--ink); transform: translateX(8px); } }

    .project { min-height: 92svh; display: flex; flex-direction: column; justify-content: center; max-width: 46ch; padding: 48px 0; }
    .project__name { font-size: var(--step-head); font-weight: 600; line-height: 1; letter-spacing: -0.035em; }
    .project__meta { margin-top: 16px; }
    .project__text { margin-top: 24px; }

    /* ---------- scene: the opening window ---------- */
    .series { background: var(--stage); }
    .series__stage { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: clamp(28px, 5svh, 56px); padding: clamp(56px, 9svh, 104px) var(--margin); }
    .series__cards { position: relative; --cols: 4; --rows: 2; --gap: clamp(8px, 1vw, 16px); display: grid; grid-template-columns: repeat(var(--cols), 1fr); gap: var(--gap); width: min(100%, calc((100svh - 330px) * var(--cols) / var(--rows))); }
    .series__card img { width: 100%; height: auto; aspect-ratio: 1; }
    .series__text { text-align: center; max-width: 40ch; }
    .series__lead { margin-top: 18px; color: var(--muted); }
    html.js .series.is-live .series__stage { padding-block: clamp(32px, 5svh, 64px); }

    /* ---------- films list ---------- */
    .films__sub { margin-top: 20px; max-width: 44ch; }
    .eps { margin-top: 36px; max-width: 46ch; }
    .ep {
      width: 100%; display: grid; grid-template-columns: 16px 1fr auto; align-items: baseline; gap: 14px;
      min-height: 56px; padding: 12px 0; background: none; border: 0; text-align: left; cursor: pointer;
      transition: transform var(--t-ui) var(--ease-out);
    }
    .ep__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--surface); align-self: center; transition: background-color var(--t-hover) ease, transform var(--t-ui) var(--ease-out); }
    .ep__title { display: flex; flex-direction: column; gap: 2px; font-size: var(--step-body); font-weight: 500; }
    .ep__date { font-variant-numeric: tabular-nums; }
    .ep[aria-pressed="true"] .ep__dot { background: var(--accent); transform: scale(1.3); }
    .ep[aria-pressed="true"] .ep__title { color: var(--ink); }
    .ep[aria-pressed="false"] .ep__title { color: color-mix(in srgb, var(--ink) 82%, var(--bg)); }
    @media (hover: hover) and (pointer: fine) { .ep:hover { transform: translateX(8px); } .ep:hover .ep__dot { background: var(--muted); } .ep[aria-pressed="true"]:hover .ep__dot { background: var(--accent); } }
    .ep:active { transform: scale(0.99); }

    /* ---------- demo ---------- */
    .demo__sub { margin-top: 20px; max-width: 44ch; }
    .demo__body { margin-top: 32px; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; max-width: 46rem; }
    .demo__fields { grid-column: 1 / -1; border: 0; padding: 0; margin: 0 0 8px; display: flex; flex-wrap: wrap; gap: 10px; }
    .demo__fields label { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 16px; background: var(--surface); cursor: pointer; transition: background-color var(--t-hover) ease; }
    .demo__fields label:has(input:checked) { background: color-mix(in srgb, var(--accent) 18%, var(--surface)); }
    .demo__fields input { accent-color: var(--accent); width: 18px; height: 18px; margin: 0; }
    .demo__pane {
      margin: 0; padding: 20px; min-height: 180px; background: var(--surface); color: var(--muted); overflow-x: auto;
      /* taste-skill-ignore: real code (a GraphQL query and its response), set in <pre><code> */
      font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace; font-size: 14px; line-height: 1.6;
    }
    .demo__pane--out { color: var(--accent); }

    /* ---------- about ---------- */
    .about__face { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; margin-bottom: 28px; }
    .about__letter { margin-top: 36px; max-width: 46ch; display: grid; gap: 1.1em; }
    .about__sign { margin-top: 36px; display: flex; flex-direction: column; gap: 4px; }
    .about__actions { display: flex; align-items: center; gap: 28px; margin-top: 36px; padding-bottom: var(--gap-section); }

    /* ---------- contact ---------- */
    .contact { background: var(--stage); padding: clamp(120px, 18svh, 200px) var(--margin) clamp(120px, 16svh, 160px); display: flex; justify-content: center; }
    .contact__col { width: min(560px, 100%); }
    .contact__prompt { font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); font-weight: 500; line-height: 1.25; letter-spacing: -0.02em; }
    .contact__form { position: relative; margin-top: 28px; }
    .contact__field {
      width: 100%; height: 64px; padding: 0 72px 0 22px; border: 0; border-radius: 0;
      background: #1d2740; color: var(--ink); font-size: var(--step-body);
    }
    .contact__field::placeholder { color: #9aa6ba; }
    .contact__field:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
    .contact__send {
      position: absolute; right: 10px; top: 10px; width: 44px; height: 44px; border-radius: 50%; border: 0;
      background: var(--accent); color: var(--accent-ink); display: grid; place-items: center; cursor: pointer;
      transition: transform var(--t-press) var(--ease-out), background-color var(--t-hover) ease;
    }
    .contact__send:active { transform: scale(0.94); }
    @media (hover: hover) and (pointer: fine) { .contact__send:hover { background: var(--accent-strong); } .contact__send:hover svg { transform: translateX(2px); } }
    .contact__send svg { transition: transform var(--t-ui) var(--ease-out); }
    .contact__note { margin-top: 16px; }
    .contact__rows { margin: 72px 0 0; display: grid; gap: 14px; }
    .contact__rows div { display: grid; grid-template-columns: 96px 1fr; gap: 16px; }
    .contact__rows dd { margin: 0; overflow-wrap: anywhere; }

    /* ---------- footer ---------- */
    .footer { display: grid; grid-template-columns: 1fr 1fr; min-height: 100svh; }
    .footer__film { background: var(--stage); display: flex; align-items: center; justify-content: center; padding: clamp(24px, 4vw, 64px); overflow: clip; }
    .footer__film video { width: 100%; max-height: 100%; aspect-ratio: 1; object-fit: contain; }
    .footer__menu { background: var(--surface); display: flex; flex-direction: column; padding: clamp(32px, 5vw, 80px) var(--pad); }
    .footer__mark { color: var(--muted); }
    .footer__links { margin-top: clamp(32px, 6svh, 64px); display: grid; gap: clamp(8px, 1.4svh, 16px); }
    .footer__links a { display: inline-block; font-size: var(--step-head); font-weight: 600; letter-spacing: -0.035em; line-height: 1.05; text-decoration: none; transition: transform var(--t-ui) var(--ease-out), color var(--t-hover) ease; }
    @media (hover: hover) and (pointer: fine) {
      .footer__links:hover a { color: var(--muted); }
      .footer__links a:hover { color: var(--ink); transform: translateX(12px); }
    }
    .footer__blocks { margin-top: 64px; display: flex; gap: 48px; flex-wrap: wrap; }
    .footer__legal { margin-top: auto; padding-top: 48px; }

    /* ---------- phone and narrow tablet: a composition of its own ---------- */
    @media (max-width: 1023px) {
      .split { display: block; }
      .stage { display: none; }
      .m-only { display: block; }
      .read { padding: 0 20px; }
      .nav { padding: 18px 0; }
      .nav__cv { display: none; }
      .hero { min-height: 0; display: block; }
      .hero__photo { position: sticky; top: 0; z-index: 0; height: 46svh; margin: 0 -20px; background: var(--stage); }
      .hero__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; }
      .hero__body { position: relative; z-index: 1; background: var(--bg); margin: -28px -20px 0; padding: 28px 20px 0; }
      .hero .display { font-size: clamp(3.4rem, 15vw, 6rem); }
      .hero__sentence { margin-top: 28px; }
      .hero__actions { margin-top: 28px; }
      .sec { padding-top: clamp(80px, 14vw, 112px); }
      .m-film { margin: 28px -20px 0; background: var(--stage); padding: 0 20px; }
      .m-film video { width: 100%; max-width: 560px; aspect-ratio: 1; height: auto; margin: 0 auto; background: var(--stage); }
      .project { min-height: 0; padding: clamp(72px, 12vw, 96px) 0 0; }
      .project .m-film { margin-top: 0; margin-bottom: 28px; }
      .index { margin-top: 28px; }
      .demo__body { grid-template-columns: 1fr; }
      .about__actions { padding-bottom: clamp(80px, 14vw, 112px); }
      .contact { padding: 96px 20px 112px; }
      .contact__rows { margin-top: 56px; }
      .contact__rows div { grid-template-columns: 1fr; gap: 2px; }
      .footer { grid-template-columns: 1fr; min-height: 0; }
      .footer__film { padding: 20px; }
      .footer__film video { max-width: 560px; }
      .footer__menu { padding: 40px 20px 32px; }
      .footer__links a { font-size: clamp(2rem, 9vw, 3rem); }
      .footer__blocks { margin-top: 40px; gap: 24px; flex-direction: column; }
    }
    @media (min-width: 700px) and (max-width: 1023px) {
      .project { display: grid; grid-template-columns: 1fr 1fr; column-gap: 32px; align-content: center; max-width: none; }
      .project .m-film { grid-column: 1; grid-row: 1 / span 3; margin: 0; padding: 0; align-self: center; }
      .project > :not(.m-film) { grid-column: 2; }
      .project__name { align-self: end; }
      .intro { display: grid; grid-template-columns: 1fr 1fr; column-gap: 32px; }
      .intro > .head { grid-column: 1 / -1; }
      .intro .m-film { margin: 40px 0 0; padding: 0; align-self: start; }
      .intro__text { margin-top: 40px; }
      .films { display: grid; grid-template-columns: 1fr 1fr; column-gap: 32px; }
      .films > .head, .films > .films__sub { grid-column: 1 / -1; }
      .films .m-film { margin: 36px 0 0; padding: 0; align-self: start; position: sticky; top: 24px; }
      .films .eps { margin-top: 36px; }
    }
    @media (max-width: 699px) {
      .films .m-film { position: sticky; top: 0; z-index: 2; padding-block: 12px; }
      .films .m-film video { max-height: 38svh; width: auto; }
    }
    @media (max-width: 599px) {
      .hero__actions .btn, .about__actions .btn { flex: 1; }
    }
    @media (max-width: 767px) {
      .series__stage { padding: 72px 20px; }
      .series__cards { --cols: 2; --rows: 4; width: min(100%, calc((100svh - 300px) * var(--cols) / var(--rows)), 360px); }
      .series__lead { font-size: var(--step-body); }
    }
  </style>
</body>
</html>
