---
import '../styles/tokens.css';

const email = 'dhanushkadilshancc@gmail.com';
const linkedin = 'https://www.linkedin.com/in/dhanushkacc/';
const github = 'https://github.com/dhanushkacc';
const cvHref = '/Dhanushka_Dilshan_CV.pdf';
const mailtoHero = 'mailto:' + email + '?subject=' + encodeURIComponent('Hello, from your portfolio');
const mailtoPlain = 'mailto:' + email;
const [emailUser, emailHost] = email.split('@');

const series = [
  { title: 'Why GraphQL', format: 'Video, 0:30', topic: 'One screen, two ways', date: 'Oct 22', group: 'October 2026' },
  { title: 'The Schema', format: 'Video, 0:39', topic: 'The contract', date: 'Oct 24', group: 'October 2026' },
  { title: 'Resolvers', format: 'Video, 0:44', topic: 'Field by field', date: 'Oct 26', group: 'October 2026' },
  { title: 'The N+1 problem', format: 'Video, 0:42', topic: 'Watch the database log', date: 'Oct 28', group: 'October 2026' },
  { title: 'DataLoader', format: 'Video, 0:38', topic: '101 queries become 2', date: 'Oct 30', group: 'October 2026' },
  { title: 'Securing GraphQL', format: 'Video, 0:44', topic: 'Depth and complexity limits', date: 'Nov 1', group: 'November 2026' },
  { title: 'Pagination', format: 'Video, 0:46', topic: 'One page at a time', date: 'Nov 3', group: 'November 2026' },
  { title: 'Business Lineage', format: 'Video, 0:51', topic: 'Where it all came together', date: 'Nov 5', group: 'November 2026' },
];

// The work section is one connected graph, in the same node/edge language as Business
// Lineage itself: a hub (the Lineage feature) with four spokes, each carrying a real,
// specific relationship label back to it — the page's structure becomes the idea.
const hub = {
  id: 'lineage', name: 'LINEAGE',
  line: 'GraphQL API and data map, 2026',
  text: "Business Lineage is an interactive map of how data flows between sources, data models, datasets and systems, and which classifications, policies and compliance rules apply. I designed and built it, with a Spring for GraphQL API that loads neighbouring nodes in batches, pages through large graphs with cursors and caps the size of a single request.",
  img: '/media/still-map.jpg', alt: 'An example data-lineage map: a source connects to a data model, a dataset and a system',
  intro: "Four more projects connect to it below. Open one to see how.",
};
const spokes = [
  {
    id: 'governance', name: 'GOVERNANCE', relation: 'feeds the map',
    line: 'Data governance APIs, 2025–2026',
    text: "The core of XAPI's data governance: REST APIs that let an organization catalog its data sources and model them as ER-style data models, with datasets, fields and relationships. Every API started as an OpenAPI contract, so the frontend could build against it in parallel. This is the data Business Lineage draws its map from.",
    img: '/media/node-governance.png', alt: 'A GraphQL type for a data model, with its source, datasets, fields and relationships',
  },
  {
    id: 'access', name: 'ACCESS', relation: 'secures every node',
    line: 'Security and performance, 2025–2026',
    text: "I hardened role-based access control across six or more microservices and fixed a flaw that could leak one user's session data into another request. Then I made authorization faster: permissions load in batches, sit in an in-memory Caffeine cache, and stay in sync across service instances through RabbitMQ. The same checks guard every node Lineage shows.",
    img: '/media/node-access.png', alt: 'A permission cache check, and a count of six or more hardened microservices',
  },
  {
    id: 'streaming', name: 'STREAMING', relation: 'same platform',
    line: 'Full-stack, XCLP, 2025',
    text: "For XCLP, the company's compliance learning platform, I built secure video streaming with AWS CloudFront signed cookies, so only enrolled learners can watch a course. I also built course, enrollment and authentication features in Spring Boot and Angular — the same stack and the same access rules as the governance platform.",
    img: '/media/node-streaming.png', alt: 'A video player frame beside a signed-cookie code snippet',
  },
  {
    id: 'agents', name: 'AGENTS', relation: 'traces it live',
    line: 'AI-assisted engineering, 2026',
    text: "I set up an engineering workflow on Claude Code, with custom skills, subagents and Kubernetes MCP servers that let AI agents read production logs and trace a bug to the service responsible, with guardrails on production access. I also extended XAPI's MCP server so AI assistants can use platform features, lineage included, as tools.",
    img: '/media/node-agents.png', alt: 'A terminal tracing a production error back to the responsible resolver',
  },
];
const work = [hub, ...spokes];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Dhanushka Dilshan, backend engineer</title>
  <meta name="description" content="Backend engineer in Colombo building XAPI's data governance APIs and Business Lineage with Java, Spring Boot and GraphQL." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://api.fontshare.com" />
  <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
  <link href="https://api.fontshare.com/v2/css?f[]=zodiak@100,300,400&display=swap" rel="stylesheet" />
</head>
<body>

  <header class="nav">
    <a class="nav__mark link" href="#top">Dhanushka Dilshan</a>
    <nav class="nav__links">
      <a class="link" href="#work">Work</a>
      <a class="link" href="#writing">Writing</a>
    </nav>
  </header>

  <main id="top">

    <!-- 1. HERO -->
    <section class="hero">
      <img class="hero__portrait" src="/media/portrait.png" width="800" height="1000" alt="Portrait of Dhanushka Dilshan" />
      <h1 class="hero__name">
        <span class="hero__line hero__line--1">DHANUSHKA</span>
        <span class="hero__line hero__line--2">DILSHAN</span>
      </h1>
      <div class="hero__mid">
        <p class="hero__sentence">Backend engineer in Colombo. I build the APIs behind XAPI, a platform for data, API and AI governance.</p>
        <a class="btn hero__cta" href={mailtoHero}>Get in touch</a>
      </div>
    </section>

    <!-- 2. INTRO: staircase statement -->
    <section class="intro">
      <div class="intro__col">
        <h2 class="intro__head">APIs that show<br /><span class="intro__accent">where data goes</span></h2>
        <p class="intro__sub">From the source it comes from to the systems and rules it passes through.</p>
      </div>
      <div class="intro__photos">
        <video class="intro__clip" src="/media/finale-loop.webm" poster="/media/still-map.jpg" width="640" height="427" autoplay muted loop playsinline aria-label="The Business Lineage data map building, from the GraphQL in Practice finale"></video>
        <img src="/media/still-batch.jpg" width="640" height="427" loading="lazy" alt="A batched DataLoader request replacing many database calls, from the GraphQL in Practice series" />
        <p class="intro__note">Stills from GraphQL in Practice, the video series I publish on LinkedIn.</p>
      </div>
    </section>

    <!-- 3. WORK: one lineage graph — a hub and four spokes, the same shape as the feature itself -->
    <section class="work" id="work">
      <h2 class="section-head work__head reveal">Selected work</h2>
      <div class="graph" data-graph>
        <svg class="graph__lines" viewBox="0 0 1000 560" preserveAspectRatio="none" aria-hidden="true">
          {spokes.map((s, i) => (
            <line class="graph__line" data-to={s.id}
              x1="500" y1="170"
              x2={125 + i * 250} y2="460"></line>
          ))}
        </svg>
        <button class="node node--hub reveal" type="button" data-node={hub.id} aria-expanded="true" aria-controls="node-detail">
          <img src={hub.img} width="640" height="400" loading="lazy" alt={hub.alt} />
          <span class="node--hub__text">
            <span class="node__name">{hub.name}</span>
            <span class="node__intro">{hub.intro}</span>
          </span>
        </button>
        <div class="graph__spokes">
          {spokes.map((s, i) => (
            <button class="node node--spoke reveal" style={`transition-delay:${i * 90}ms`} type="button" data-node={s.id} aria-expanded="false" aria-controls="node-detail">
              <img src={s.img} width="500" height="400" loading="lazy" alt={s.alt} />
              <span class="node__name">{s.name}</span>
              <span class="node__relation">{s.relation}</span>
            </button>
          ))}
        </div>
      </div>
      <div class="detail" id="node-detail" aria-live="polite">
        {work.map((p) => (
          <div class="detail__panel" data-detail={p.id} hidden={p.id !== hub.id}>
            <div class="detail__copy">
              <h3 class="detail__title">{p.name}</h3>
              <p class="detail__line">{p.line}</p>
              <p class="detail__text">{p.text}</p>
            </div>
            <img class="detail__image" src={p.img} width="640" height="480" loading="lazy" alt={p.alt} />
          </div>
        ))}
      </div>
    </section>

    <!-- 4. WRITING: live demo + series table -->
    <section class="writing" id="writing">
      <h2 class="section-head reveal">GraphQL in Practice</h2>

      <div class="demo reveal" data-query-demo>
        <h3 class="demo__head">Ask for exactly what you need</h3>
        <p class="demo__sub">Tick the fields you want. The response changes shape to match, the way GraphQL does.</p>
        <div class="demo__body">
          <fieldset class="demo__fields">
            <legend class="sr-only">Fields to request</legend>
            <label><input type="checkbox" value="name" checked /> name</label>
            <label><input type="checkbox" value="role" checked /> role</label>
            <label><input type="checkbox" value="stack" /> stack</label>
            <label><input type="checkbox" value="projects" /> projects</label>
            <label><input type="checkbox" value="writing" /> writing</label>
          </fieldset>
          <div class="demo__panes">
            <pre class="demo__pane"><code>query {'{'}<br />  <span data-query-fields>name{'\n'}  role</span><br />{'}'}</code></pre>
            <pre class="demo__pane demo__pane--accent"><code data-query-output>{'{ }'}</code></pre>
          </div>
        </div>
      </div>

      <div class="table reveal">
        {['October 2026', 'November 2026'].map((group) => (
          <div class="table__group">
            <p class="table__group-head">{group}</p>
            {series.filter((s) => s.group === group).map((s) => (
              <div class="table__row">
                <span class="table__title">{s.title}</span>
                <span class="table__format">{s.format}</span>
                <span class="table__topic">{s.topic}</span>
                <span class="table__date">{s.date}</span>
              </div>
            ))}
          </div>
        ))}
      </div>
    </section>

    <!-- 5. ABOUT: inset panel, shaped portrait -->
    <section class="about" id="about">
      <div class="about__panel reveal">
        <h2 class="about__statement">Contract first,<br />then the code</h2>
        <img class="about__portrait" src="/media/portrait-square.jpg" width="560" height="560" loading="lazy" alt="Dhanushka Dilshan" />
        <div class="about__col">
          <h3 class="about__sub">How I work</h3>
          <p class="about__p">I write each API as an OpenAPI contract before the code, so other teams can build in parallel. Every feature ships with JUnit and Mockito tests, a SonarQube check and an 80% coverage target, in Agile sprints. Day to day I use Java, Spring Boot, Spring for GraphQL, Spring Security, RabbitMQ, Kubernetes and AWS.</p>
        </div>
        <div class="about__col">
          <h3 class="about__sub">How I got here</h3>
          <p class="about__p">I studied Computer Science at the University of Colombo School of Computing and joined X-Venture as an intern in November 2024. Six months later I joined full time, building XAPI.</p>
          <div class="about__actions">
            <a class="btn" href={mailtoPlain}>Get in touch</a>
            <a class="link" href={cvHref}>Download CV</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. CONTACT: inverted field -->
    <section class="contact" id="contact">
      <p class="contact__ask reveal">Hiring for a backend or GraphQL role? Write to me.</p>
      <a class="contact__email" href={mailtoPlain} aria-label={`Email ${email}`}>
        <span class="contact__email-line">{emailUser}@</span>
        <span class="contact__email-line">{emailHost}</span>
      </a>
      <p class="contact__city">Colombo, Sri Lanka</p>
      <nav class="contact__links">
        <a class="link" href={linkedin}>LinkedIn</a>
        <a class="link" href={github}>GitHub</a>
        <a class="link" href={cvHref}>Download CV</a>
      </nav>
    </section>

  </main>

  <!-- 7. FOOTER -->
  <footer class="footer">
    <img class="footer__photo" src="/media/colombo-archival.jpg" width="2400" height="1869" loading="lazy" alt="Hoek York Street and Chatham Street, Colombo, an archival photograph of the city" />
    <div class="footer__scrim footer__scrim--top"></div>
    <div class="footer__scrim footer__scrim--bottom"></div>
    <nav class="footer__links">
      <a class="link" href="#work">Work</a>
      <a class="link" href="#writing">Writing</a>
      <a class="link" href="#about">About</a>
      <a class="link" href="#contact">Contact</a>
    </nav>
    <div class="footer__contact">
      <a class="link" href={mailtoPlain}>{email}</a>
      <a class="link" href={linkedin}>linkedin.com/in/dhanushkacc</a>
      <a class="link" href={github}>github.com/dhanushkacc</a>
    </div>
    <h2 class="footer__mark">DHANUSHKA DILSHAN</h2>
    <p class="credits footer__credit">
      © 2026 Dhanushka Dilshan. Picture: <a href="https://commons.wikimedia.org/w/index.php?curid=85210909">“Hoek York Street en Chatham Street, Colombo”</a>, Rijksmuseum, CC0, via Wikimedia Commons.
    </p>
  </footer>

  <script src="/scripts/reveal.js" type="module"></script>
  <script src="/scripts/query-demo.js" type="module"></script>
  <script src="/scripts/graph.js" type="module"></script>

  <style>
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

    /* Nav */
    .nav {
      position: absolute; top: 0; left: 0; right: 0; z-index: 5;
      display: flex; justify-content: space-between; align-items: center;
      padding: var(--margin);
      font-size: var(--step-small);
    }
    .nav__links { display: flex; gap: clamp(16px, 2vw, 32px); }

    /* 1. HERO */
    .hero {
      position: relative;
      min-height: 100svh;
      display: grid;
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr auto;
      background: var(--bg);
      overflow: hidden;
      padding: 0 var(--margin);
    }
    .hero__portrait {
      position: absolute; right: clamp(0px, 4vw, 64px); bottom: 0;
      height: 92svh; width: auto; object-fit: contain; object-position: bottom;
      filter: grayscale(0.25) brightness(0.92) contrast(1.05);
      z-index: 0;
    }
    .hero__name {
      grid-row: 1 / 4; grid-column: 1;
      position: relative; z-index: 1; pointer-events: none;
      display: grid; grid-template-rows: auto 1fr auto;
      width: 100%; height: 100%;
    }
    .hero__line {
      position: relative; z-index: 2; pointer-events: auto;
      font-size: var(--step-display);
      line-height: 0.85;
      letter-spacing: -0.02em;
      font-weight: 100;
      mix-blend-mode: difference;
    }
    .hero__line--1 { grid-row: 1; justify-self: start; padding-top: 72px; }
    .hero__line--2 { grid-row: 3; justify-self: end; text-align: right; padding-bottom: 24px; }
    .hero__mid {
      grid-row: 2; grid-column: 1; z-index: 1; align-self: center;
      max-width: 48ch;
      display: flex; flex-direction: column; gap: 28px;
    }
    .hero__sentence { font-size: var(--step-lead); color: var(--ink); max-width: 38ch; }
    .hero__cta { width: fit-content; }
    @media (max-width: 860px) {
      .hero { padding: 0 16px; }
      .hero__line { font-size: 15vw; }
      .hero__line--1 { padding-top: 88px; }
      .hero__portrait { height: 54svh; opacity: 0.9; }
      .hero__mid { grid-row: 2; align-self: start; margin-top: 40svh; max-width: 90vw; }
      .hero__sentence { max-width: 32ch; }
    }

    /* 2. INTRO */
    .intro {
      position: relative;
      display: grid;
      grid-template-columns: 1fr clamp(220px, 22vw, 320px);
      align-items: start;
      gap: clamp(24px, 4vw, 64px);
      padding: var(--gap-section) var(--margin) clamp(48px,6vw,88px);
      background: var(--bg);
    }
    .intro__head {
      font-family: 'Hanken Grotesk', sans-serif;
      font-size: clamp(2.5rem, 1.4rem + 5vw, 5.5rem);
      font-weight: 600;
      line-height: 1.05;
      letter-spacing: -0.01em;
      margin: 0 0 24px;
      max-width: 14ch;
    }
    .intro__accent { color: var(--accent); }
    .intro__sub { font-size: var(--step-lead); color: var(--muted); max-width: 32ch; }
    .intro__photos { display: flex; flex-direction: column; gap: 16px; }
    .intro__photos img, .intro__photos video { aspect-ratio: 3/2; object-fit: cover; object-position: top; width: 100%; }
    .intro__note { font-size: var(--step-small); color: var(--muted); }
    @media (max-width: 760px) {
      .intro { grid-template-columns: 1fr; padding: clamp(72px,16vw,120px) 16px; }
      .intro__head { font-size: 10.5vw; }
      .intro__photos { flex-direction: row; flex-wrap: wrap; }
      .intro__note { width: 100%; }
    }

    /* 3. WORK — one lineage graph: a hub node and four spokes, connected by lines,
       each a real button that opens its write-up in the shared panel below. */
    .work { background: var(--bg); padding: var(--gap-section) 0 0; }
    .work__head { padding: 0 var(--margin); margin-bottom: clamp(48px, 7vw, 96px); }
    .graph { position: relative; padding: 0 var(--margin); }
    .graph__lines { position: absolute; inset: 0; width: 100%; height: 100%; }
    .graph__line { stroke: var(--surface-2); stroke-width: 1.5; transition: stroke 0.3s var(--ease-out); }
    .graph__line.is-active { stroke: var(--accent); }
    .node {
      display: block; width: 100%; text-align: left;
      background: none; border: 0; padding: 0; color: inherit; cursor: pointer;
      font: inherit;
    }
    .node__name {
      display: block; margin-top: 14px;
      font-size: var(--step-lead); font-weight: 600; letter-spacing: -0.01em;
    }
    .node__relation { display: block; margin-top: 4px; font-size: var(--step-small); color: var(--muted); }
    .node img {
      display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: left top;
      background: var(--surface); filter: brightness(0.85) saturate(0.95);
      outline: 1.5px solid var(--surface-2); outline-offset: -1.5px;
      transition: outline-color 0.3s var(--ease-out), filter 0.3s var(--ease-out);
    }
    .node:hover img, .node.is-active img { outline-color: var(--accent); filter: brightness(1) saturate(1); }
    .node--hub {
      position: relative; z-index: 1; width: 100%;
      display: grid; grid-template-columns: minmax(260px, 1fr) 1.3fr;
      gap: clamp(32px, 4.5vw, 64px); align-items: center;
    }
    .node--hub__text { display: flex; flex-direction: column; gap: 14px; }
    .node--hub .node__name { font-size: var(--step-head); }
    .node__intro { font-size: var(--step-lead); color: var(--muted); max-width: 32ch; }
    .graph__spokes {
      position: relative; z-index: 1; margin-top: clamp(72px, 11vw, 160px);
      display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(16px, 2.4vw, 32px);
    }
    .detail {
      margin-top: clamp(56px, 8vw, 100px); padding: clamp(32px, 4.5vw, 56px) var(--margin) clamp(48px,6vw,88px);
      background: var(--surface);
    }
    .detail__panel {
      display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(32px, 4.5vw, 64px); align-items: center;
    }
    .detail__panel[hidden] { display: none; }
    .detail__copy { max-width: 60ch; }
    .detail__title { font-size: clamp(32px, 4.5vw, 56px); font-weight: 300; letter-spacing: -0.02em; margin-bottom: 10px; }
    .detail__line { font-size: var(--step-small); color: var(--muted); margin-bottom: 18px; }
    .detail__text { font-size: var(--step-body); color: var(--ink); }
    .detail__image {
      width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: left top;
      background: var(--bg); outline: 1.5px solid var(--surface-2); outline-offset: -1.5px;
    }
    @media (max-width: 760px) {
      .graph__lines { display: none; }
      .node--hub { grid-template-columns: 1fr; text-align: left; }
      .graph__spokes { grid-template-columns: 1fr 1fr; margin-top: 32px; }
      .detail { padding: 28px 16px; }
      .detail__panel { grid-template-columns: 1fr; }
      .detail__image { order: -1; }
    }

    /* 4. WRITING */
    .writing { padding: var(--gap-section) var(--margin) clamp(48px,6vw,88px); background: var(--bg); }
    .demo {
      background: var(--surface);
      padding: clamp(24px, 4vw, 48px);
      margin-bottom: clamp(64px, 8vw, 120px);
    }
    .demo__head { font-family: 'Hanken Grotesk', sans-serif; font-weight: 600; font-size: var(--step-lead); margin-bottom: 8px; }
    .demo__sub { color: var(--muted); max-width: 60ch; margin-bottom: 28px; }
    .demo__body { display: grid; grid-template-columns: 180px 1fr; gap: clamp(20px,3vw,40px); }
    .demo__fields { border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 14px; }
    .demo__fields label { display: flex; align-items: center; gap: 10px; cursor: pointer; }
    .demo__fields input { accent-color: var(--accent); width: 18px; height: 18px; }
    .demo__panes { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .demo__pane {
      margin: 0; padding: 20px; background: var(--bg); color: var(--muted);
      /* taste-skill-ignore: real code (a GraphQL query/response), set in <pre><code> */
      font-family: ui-monospace, 'SFMono-Regular', monospace; font-size: 15px; line-height: 1.6;
      overflow: auto; white-space: pre-wrap; word-break: break-word;
    }
    .demo__pane--accent { color: var(--accent); }
    @media (max-width: 760px) {
      .demo__body { grid-template-columns: 1fr; }
      .demo__panes { grid-template-columns: 1fr; }
    }

    .table__group-head { color: var(--accent); font-size: var(--step-small); font-weight: 600; margin: 48px 0 12px; }
    .table__group:first-child .table__group-head { margin-top: 0; }
    .table__row {
      display: grid; grid-template-columns: 2fr 1.2fr 2.4fr auto;
      gap: 16px; padding: 18px 24px;
      font-size: clamp(16px, 1.6vw, 20px);
    }
    .table__row:nth-child(even) { background: var(--surface); }
    .table__date { font-variant-numeric: tabular-nums; color: var(--muted); text-align: right; }
    .table__format, .table__topic { color: var(--muted); }
    @media (max-width: 700px) {
      .table__row { grid-template-columns: 1fr auto; row-gap: 2px; font-size: 16px; }
      .table__format, .table__topic { grid-column: 1 / -1; font-size: 14px; }
    }

    /* 5. ABOUT */
    .about { padding: var(--gap-section) var(--margin) clamp(48px,6vw,88px); background: var(--bg); }
    .about__panel {
      position: relative;
      background: var(--surface);
      min-height: 100svh;
      padding: 56px clamp(20px, 4vw, 56px);
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto 1fr;
      gap: 24px 48px;
    }
    .about__statement { grid-column: 1 / 2; font-size: clamp(40px, 4.4vw, 64px); line-height: 1.05; color: var(--ink); }
    .about__portrait {
      grid-column: 1 / 2; grid-row: 2 / 3; align-self: end;
      width: min(38vw, 440px);
      clip-path: polygon(14% 0, 100% 0, 100% 86%, 86% 100%, 0 100%, 0 14%);
      filter: brightness(0.9);
    }
    .about__col { grid-column: 2 / 3; max-width: 420px; display: flex; flex-direction: column; gap: 14px; align-self: start; }
    .about__col:nth-of-type(3) { grid-row: 2 / 3; align-self: end; padding-bottom: 8px; }
    .about__sub { font-family: 'Hanken Grotesk', sans-serif; font-weight: 600; font-size: var(--step-lead); }
    .about__p { color: var(--ink); }
    .about__actions { display: flex; align-items: center; gap: 24px; margin-top: 8px; }
    @media (max-width: 860px) {
      .about__panel { grid-template-columns: 1fr; grid-template-rows: auto auto auto auto; padding: 32px 16px; }
      .about__statement, .about__portrait, .about__col, .about__col:nth-of-type(3) { grid-column: 1; grid-row: auto; }
      .about__portrait { width: 72vw; margin: 0 auto; }
      .about__statement { font-size: 8.5vw; }
    }

    /* 6. CONTACT */
    .contact {
      min-height: 100svh;
      background: var(--field-1); color: var(--field-1-ink);
      position: relative;
      display: flex; flex-direction: column; justify-content: center; gap: clamp(32px, 6vh, 64px);
      padding: var(--margin) var(--margin) clamp(120px, 16vh, 180px);
    }
    .contact__ask { max-width: 24ch; font-size: var(--step-lead); }
    .contact__email {
      font-family: 'Zodiak', serif; font-weight: 100;
      font-size: clamp(28px, 6.5vw, 96px);
      line-height: 1.04;
      letter-spacing: -0.01em;
      color: var(--field-1-ink);
      text-decoration: none;
      align-self: flex-start;
      max-width: 100%;
      transition: color 220ms var(--ease-out);
    }
    .contact__email-line { display: block; overflow-wrap: anywhere; }
    .contact__email:hover, .contact__email:focus-visible { color: var(--accent-ink); background: var(--accent); }
    .contact__city { position: absolute; left: var(--margin); bottom: var(--margin); font-size: var(--step-small); }
    .contact__links { position: absolute; right: var(--margin); bottom: var(--margin); display: flex; gap: 20px; font-size: var(--step-small); }
    .contact .link { color: var(--field-1-ink); text-decoration-color: #0b132780; }
    @media (max-width: 760px) {
      .contact__email { font-size: 8vw; }
      .contact__city, .contact__links { position: static; margin-top: 24px; }
      .contact { padding: 16px; }
    }

    /* 7. FOOTER */
    .footer {
      position: relative;
      min-height: 100svh;
      overflow: hidden;
      display: grid;
      grid-template-rows: auto 1fr auto;
      padding: var(--margin);
    }
    .footer__photo {
      position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(0.6);
      animation: footer-drift 24s ease-in-out infinite alternate;
    }
    @keyframes footer-drift {
      from { transform: scale(1); }
      to { transform: scale(1.06); }
    }
    @media (prefers-reduced-motion: reduce) {
      .footer__photo { animation: none; }
    }
    /* Two flat bands instead of a gradient, so the top and bottom text stay legible and the middle of the photograph stays clear. */
    .footer__scrim { position: absolute; left: 0; right: 0; background: rgba(11,19,39,0.6); }
    .footer__scrim--top { top: 0; height: 22%; }
    .footer__scrim--bottom { bottom: 0; height: 34%; }
    .footer__links, .footer__contact { position: relative; z-index: 1; display: flex; gap: 20px; font-size: var(--step-small); flex-wrap: wrap; }
    .footer__contact { justify-content: flex-end; }
    .footer__mark {
      position: relative; z-index: 1;
      font-family: 'Hanken Grotesk', sans-serif;
      font-weight: 600;
      font-size: clamp(32px, 11vw, 140px);
      line-height: 1;
      color: var(--ink);
      align-self: end;
    }
    .footer__credit { position: relative; z-index: 1; grid-row: 3; }
    @media (max-width: 760px) {
      .footer { padding: 16px; min-height: 88svh; }
      .footer__links, .footer__contact { flex-direction: column; gap: 6px; }
    }
  </style>
</body>
</html>
